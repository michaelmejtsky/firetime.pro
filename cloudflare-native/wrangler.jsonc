{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firetime-native-staging",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "dist/public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "firetime-native-staging", "database_id": "REPLACE_WITH_NEW_STAGING_D1_ID", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "FILES", "bucket_name": "firetime-native-staging-files"}],
  "vars": {
    "MIGRATION_MODE": "staging",
    "WRITE_ENABLED": "false",
    "CUTOVER_CONFIRMED": "false",
    "PUBLIC_ORIGINS": "https://michaelmejtsky.github.io",
    "FT_PUBLIC_GITHUB_URL": "https://michaelmejtsky.github.io/firetime.pro/",
    "MAIL_ENABLED": "false",
    "PUSH_ENABLED": "false",
    "CALENDAR_ENABLED": "false",
    "AUTOMATION_ENABLED": "false"
  },
  "triggers": {"crons": ["*/5 * * * *"]},
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "limits": {"cpu_ms": 1000}
}
