// Neue leere Instanz. Separater Worker; ersetzt den bisherigen Testbetrieb nicht.
// R2-Bucket firetime-pro-files muss im selben Konto vorhanden sein.
// FT_PEPPER und FIRST_START_KEY nur als Secrets setzen.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firetime-pro-neu",
  "account_id": "6f5bdd91743514e54696c78b05fba911",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firetime-pro-db",
      "database_id": "36e16881-02fb-4c25-90a0-b6c326caa846",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "firetime-pro-files"
    }
  ],
  "vars": {
    "MIGRATION_MODE": "production",
    "WRITE_ENABLED": "true",
    "CUTOVER_CONFIRMED": "true",
    "FIRST_START_ENABLED": "true",
    "PUBLIC_ORIGINS": "",
    "MAIL_ENABLED": "false",
    "PUSH_ENABLED": "false",
    "CALENDAR_ENABLED": "false",
    "AUTOMATION_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "limits": {
    "cpu_ms": 1000
  }
}
