// Neue Instanz mit Cloudflare D1 und privater Google-Drive-Dateiablage.
// Kein R2-Bucket erforderlich. Secrets nur direkt in Cloudflare setzen.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firetime-pro-neu",
  "account_id": "6f5bdd91743514e54696c78b05fba911",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firetime-pro-db",
      "database_id": "36e16881-02fb-4c25-90a0-b6c326caa846",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "MIGRATION_MODE": "production",
    "WRITE_ENABLED": "true",
    "CUTOVER_CONFIRMED": "true",
    "FIRST_START_ENABLED": "true",
    "PUBLIC_ORIGINS": "",
    "MAIL_ENABLED": "false",
    "PUSH_ENABLED": "false",
    "CALENDAR_ENABLED": "false",
    "AUTOMATION_ENABLED": "false",
    "FILE_STORAGE": "drive",
    "GOOGLE_DRIVE_ACCOUNT": "firetime.pro@gmail.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "limits": {
    "cpu_ms": 1000
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
